# Google AI Studio API key. Without it, the app uses deterministic demo generation.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional image providers. Pexels is queried first when configured.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# Radar data providers. Missing providers are shown as "설정 필요" and do not
# generate fallback trend data.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Optional Instagram Radar integration. Without these, Radar shows clearly labeled
# public exploration paths and never claims verified popularity rankings.
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_VERSION=v22.0

# Optional explicit delivery hook. It is called only when a ready project is sent by the user.
N8N_WEBHOOK_URL=
